{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ProtogenStudio-Debug",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Debug/studio/protogen_studio.exe",
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build Protogen Studio"
    },
    {
      "name": "tracy-profiler",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/tracy-profiler.exe",
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
    }
  ],
  "compounds": [
    {
      "name": "Debug Protogen Studio With Tracy (MSVC)",
      "configurations": ["ProtogenStudio-Debug", "tracy-profiler"]
    }
  ]
}