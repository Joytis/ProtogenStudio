{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Build Protogen Studio",
      "command": ".\\build.ps1",
      "args": [
        "-Mode",
        "Debug"
      ],
      "presentation": {
          "reveal": "always",
          "panel": "shared",
          "clear": true
      },
      "group": {
          "kind": "build",
          "isDefault": true // Optional: Set as default build task
      },
      "problemMatcher": ["$msCompile"]
    }
  ]
}